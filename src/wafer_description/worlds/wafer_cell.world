<?xml version="1.0"?>
<!--
  WaferFlow Gazebo World (Ignition Fortress / SDF 1.8)
  =====================================================
  Contains:
    - A flat workcell table
    - Source cassette (5 slots A1–A5) at x=0.55, y=0.0
    - Destination stocker (5 slots B1–B5) at x=-0.55, y=0.0
    - Overhead lighting rig
    - ros_gz_bridge plugin for ROS 2 ↔ Ignition transport
-->
<sdf version="1.8">
  <world name="wafer_cell">
    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>0.0 -0.8 0.4 0.0 0.4 1.57</pose>
      </camera>
    </gui>
    <!-- Physics: Ignition DART solver, 1kHz -->
    <physics name="default_physics" type="dart">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Required Ignition plugins -->
    <plugin filename="ignition-gazebo-physics-system"
            name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system"
            name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system"
            name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system"
            name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="ignition-gazebo-contact-system"
            name="ignition::gazebo::systems::Contact"/>
    <!-- Detachable joint for vacuum grip -->
    <plugin filename="libignition-gazebo-detachable-joint-system.so"
            name="ignition::gazebo::systems::DetachableJoint">
      <parent_link>scara_arm::ee_pad</parent_link>
      <child_model>wafer_1</child_model>
      <child_link>wafer_disc</child_link>
      <detach_topic>/waferflow/detach</detach_topic>
      <attach_topic>/waferflow/attach</attach_topic>
    </plugin>

    <!-- Sun light -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Overhead light above cassette -->
    <light name="overhead_cassette" type="point">
      <pose>0.55 0 0.8 0 0 0</pose>
      <diffuse>1.0 1.0 1.0 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>2.0</range>
        <linear>0.5</linear>
        <quadratic>0.01</quadratic>
      </attenuation>
    </light>

    <!-- Ground plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>10 10</size></plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane><normal>0 0 1</normal><size>10 10</size></plane>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Workcell table -->
    <model name="workcell_table">
      <static>true</static>
      <pose>0 0 -0.025 0 0 0</pose>
      <link name="table_top">
        <collision name="collision">
          <geometry><box><size>2.0 1.0 0.05</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>2.0 1.0 0.05</size></box></geometry>
          <material>
            <ambient>0.45 0.35 0.25 1</ambient>
            <diffuse>0.45 0.35 0.25 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Source Cassette (5 slots A1–A5) -->
    <include>
      <uri>model://cassette</uri>
      <name>source_cassette</name>
      <pose>0.55 0 0.0 0 0 0</pose>
      <static>true</static>
    </include>

    <!-- Destination Stocker (5 slots B1–B5) -->
    <include>
      <uri>model://stocker</uri>
      <name>destination_stocker</name>
      <pose>-0.55 0 0.0 0 0 0</pose>
      <static>true</static>
    </include>

    <!-- Wafer disc in slot A1 -->
    <include>
      <uri>model://wafer_disc</uri>
      <name>wafer_1</name>
      <!-- A1 center: x=0.55, y=-0.06. Z=0.063 is just above ledge (0.062) -->
      <pose>0.55 -0.06 0.063 0 0 0</pose>
    </include>

  </world>
</sdf>
