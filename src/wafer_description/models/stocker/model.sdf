<?xml version="1.0"?>
<sdf version="1.6">
  <!--
    Destination Stocker SDF Model
    ==============================
    5 slots (B1–B5), same pitch as cassette (30 mm).
    Green body to distinguish from source cassette.
  -->
  <model name="stocker">
    <static>true</static>

    <link name="stocker_body">
      <pose>0 0 0.030 0 0 0</pose>
      <visual name="body_visual">
        <geometry>
          <box><size>0.160 0.350 0.060</size></box>
        </geometry>
        <material>
          <ambient>0.15 0.50 0.25 1.0</ambient>
          <diffuse>0.15 0.50 0.25 1.0</diffuse>
          <specular>0.05 0.15 0.10 0.5</specular>
        </material>
      </visual>
      <collision name="body_collision">
        <geometry>
          <box><size>0.160 0.350 0.060</size></box>
        </geometry>
      </collision>
    </link>

    <!-- Dividers B1–B5 (same geometry as cassette) -->
    <link name="divider_b1"><pose>0 -0.075 0.062 0 0 0</pose>
      <visual name="vis"><geometry><box><size>0.120 0.002 0.004</size></box></geometry>
        <material><ambient>0.05 0.3 0.1 1</ambient></material></visual></link>
    <link name="divider_b2"><pose>0 -0.045 0.062 0 0 0</pose>
      <visual name="vis"><geometry><box><size>0.120 0.002 0.004</size></box></geometry>
        <material><ambient>0.05 0.3 0.1 1</ambient></material></visual></link>
    <link name="divider_b3"><pose>0 -0.015 0.062 0 0 0</pose>
      <visual name="vis"><geometry><box><size>0.120 0.002 0.004</size></box></geometry>
        <material><ambient>0.05 0.3 0.1 1</ambient></material></visual></link>
    <link name="divider_b4"><pose>0 0.015 0.062 0 0 0</pose>
      <visual name="vis"><geometry><box><size>0.120 0.002 0.004</size></box></geometry>
        <material><ambient>0.05 0.3 0.1 1</ambient></material></visual></link>
    <link name="divider_b5"><pose>0 0.045 0.062 0 0 0</pose>
      <visual name="vis"><geometry><box><size>0.120 0.002 0.004</size></box></geometry>
        <material><ambient>0.05 0.3 0.1 1</ambient></material></visual></link>
    <link name="divider_b_bottom"><pose>0 0.075 0.062 0 0 0</pose>
      <visual name="vis"><geometry><box><size>0.120 0.002 0.004</size></box></geometry>
        <material><ambient>0.05 0.3 0.1 1</ambient></material></visual></link>

  </model>
</sdf>
