<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="scara_arm">
  <!--
    WaferFlow SCARA Arm — Main URDF/Xacro
    ======================================
    4-DOF layout:
      joint_1  — base rotation      (revolute, Z-axis)
      joint_2  — elbow rotation     (revolute, Z-axis)
      joint_3  — wrist/EE rotation  (revolute, Z-axis)
      joint_z  — prismatic Z lift   (prismatic, Z-axis, on the base column)

    Coordinate convention: Z up, X forward (base frame = world origin).
  -->

  <xacro:include filename="$(find wafer_description)/urdf/properties.xacro"/>
  <xacro:include filename="$(find wafer_description)/urdf/end_effector.xacro"/>
  <xacro:include filename="$(find wafer_description)/urdf/scara_arm.gazebo.xacro"/>

  <!-- ╔══════════════════════════════════════╗ -->
  <!-- ║  WORLD / BASE FOOTPRINT              ║ -->
  <!-- ╚══════════════════════════════════════╝ -->
  <link name="world"/>

  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child  link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Base column (Z-lift housing) -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${z_column_height/2}" rpy="0 0 0"/>
      <geometry><cylinder radius="${z_column_radius}" length="${z_column_height}"/></geometry>
      <material name="dark_aluminium"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${z_column_height/2}" rpy="0 0 0"/>
      <geometry><cylinder radius="${z_column_radius}" length="${z_column_height}"/></geometry>
    </collision>
    <inertial>
      <mass value="5.0"/>
      <inertia ixx="0.07" ixy="0" ixz="0" iyy="0.07" iyz="0" izz="0.003"/>
    </inertial>
  </link>

  <!-- ── Prismatic Z joint (lifts the entire arm up/down) ─────────── -->
  <joint name="joint_z" type="prismatic">
    <parent link="base_link"/>
    <child  link="z_carriage"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis   xyz="0 0 1"/>
    <limit lower="${j4_lower}" upper="${j4_upper}"
           velocity="${j4_vel}" effort="${j4_effort}"/>
    <dynamics damping="5.0" friction="0.5"/>
  </joint>

  <!-- Z carriage (slider block) -->
  <link name="z_carriage">
    <visual>
      <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
      <geometry><box size="0.07 0.07 ${base_height}"/></geometry>
      <material name="light_aluminium"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
      <geometry><box size="0.07 0.07 ${base_height}"/></geometry>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <!-- ── Joint 1: base rotation ────────────────────────────────────── -->
  <joint name="joint_1" type="revolute">
    <parent link="z_carriage"/>
    <child  link="link_1"/>
    <origin xyz="0 0 ${base_height}" rpy="0 0 0"/>
    <axis   xyz="0 0 1"/>
    <limit lower="${j1_lower}" upper="${j1_upper}"
           velocity="${j1_vel}" effort="${j1_effort}"/>
    <dynamics damping="0.5" friction="0.1"/>
  </joint>

  <!-- Link 1: shoulder–elbow arm -->
  <link name="link_1">
    <visual>
      <origin xyz="${link1_length/2} 0 0" rpy="0 ${pi/2} 0"/>
      <geometry><cylinder radius="${link1_radius}" length="${link1_length}"/></geometry>
      <material name="light_aluminium"/>
    </visual>
    <collision>
      <origin xyz="${link1_length/2} 0 0" rpy="0 ${pi/2} 0"/>
      <geometry><cylinder radius="${link1_radius}" length="${link1_length}"/></geometry>
    </collision>
    <inertial>
      <mass value="1.5"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.012" iyz="0" izz="0.012"/>
    </inertial>
  </link>

  <!-- ── Joint 2: elbow rotation ───────────────────────────────────── -->
  <joint name="joint_2" type="revolute">
    <parent link="link_1"/>
    <child  link="link_2"/>
    <origin xyz="${link1_length} 0 0" rpy="0 0 0"/>
    <axis   xyz="0 0 1"/>
    <limit lower="${j2_lower}" upper="${j2_upper}"
           velocity="${j2_vel}" effort="${j2_effort}"/>
    <dynamics damping="0.3" friction="0.05"/>
  </joint>

  <!-- Link 2: elbow–wrist arm -->
  <link name="link_2">
    <visual>
      <origin xyz="${link2_length/2} 0 0" rpy="0 ${pi/2} 0"/>
      <geometry><cylinder radius="${link2_radius}" length="${link2_length}"/></geometry>
      <material name="light_aluminium"/>
    </visual>
    <collision>
      <origin xyz="${link2_length/2} 0 0" rpy="0 ${pi/2} 0"/>
      <geometry><cylinder radius="${link2_radius}" length="${link2_length}"/></geometry>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.006" iyz="0" izz="0.006"/>
    </inertial>
  </link>

  <!-- ── Joint 3: wrist / EE rotation ──────────────────────────────── -->
  <joint name="joint_3" type="revolute">
    <parent link="link_2"/>
    <child  link="ee_base"/>
    <origin xyz="${link2_length} 0 0" rpy="0 0 0"/>
    <axis   xyz="0 0 1"/>
    <limit lower="${j3_lower}" upper="${j3_upper}"
           velocity="${j3_vel}" effort="${j3_effort}"/>
    <dynamics damping="0.1" friction="0.02"/>
  </joint>

  <!-- EE base (wrist body) — end effector visual defined in end_effector.xacro -->
  <link name="ee_base">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.020"/></geometry>
      <material name="dark_aluminium"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.020"/></geometry>
    </collision>
    <inertial>
      <mass value="0.3"/>
      <inertia ixx="0.00005" ixy="0" ixz="0" iyy="0.00005" iyz="0" izz="0.00005"/>
    </inertial>
  </link>

  <!-- Attach vacuum pad end-effector (defined in end_effector.xacro) -->
  <xacro:vacuum_pad parent="ee_base" prefix=""/>

  <!-- ── Tool Center Point (TCP) frame ─────────────────────────────── -->
  <joint name="tcp_joint" type="fixed">
    <parent link="ee_base"/>
    <child  link="tcp"/>
    <origin xyz="0 0 -${ee_thickness}" rpy="0 0 0"/>
  </joint>
  <link name="tcp"/>

</robot>
