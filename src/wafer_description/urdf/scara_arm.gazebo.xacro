<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!--
    Gazebo extensions for the WaferFlow SCARA arm.
    Configured for Ignition Gazebo 6 (Fortress) + ign_ros2_control.

    Hardware plugin: ign_ros2_control/IgnitionSystem
    Publishes joint states and accepts joint trajectory commands via ros2_control.
  -->

  <!-- ── ros2_control block: Ignition hardware interface ──────────────── -->
  <ros2_control name="WaferFlowSystem" type="system">
    <hardware>
      <plugin>ign_ros2_control/IgnitionSystem</plugin>
    </hardware>

    <joint name="joint_1">
      <command_interface name="position">
        <param name="min">${j1_lower}</param>
        <param name="max">${j1_upper}</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

    <joint name="joint_2">
      <command_interface name="position">
        <param name="min">${j2_lower}</param>
        <param name="max">${j2_upper}</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

    <joint name="joint_3">
      <command_interface name="position">
        <param name="min">${j3_lower}</param>
        <param name="max">${j3_upper}</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

    <joint name="joint_z">
      <command_interface name="position">
        <param name="min">${j4_lower}</param>
        <param name="max">${j4_upper}</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </ros2_control>

  <!-- ── Ignition Gazebo: ign_ros2_control plugin ─────────────────────── -->
  <gazebo>
    <plugin filename="libign_ros2_control-system.so"
            name="ign_ros2_control::IgnitionROS2ControlPlugin">
      <parameters>$(find wafer_moveit_config)/config/ros2_controllers.yaml</parameters>
      <ros>
        <namespace>/</namespace>
      </ros>
    </plugin>
  </gazebo>

  <!-- ── Overhead camera above cassette slot A1 ────────────────────────── -->
  <link name="overhead_camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.05 0.05 0.03"/></geometry>
      <material name="dark_aluminium"/>
    </visual>
  </link>

  <joint name="world_to_camera" type="fixed">
    <parent link="world"/>
    <child  link="overhead_camera_link"/>
    <!-- Positioned 0.6 m above cassette slot A1 center (x=0.55, y=0.0) -->
    <origin xyz="0.55 0.0 0.60" rpy="0 ${pi} 0"/>
  </joint>

  <gazebo reference="overhead_camera_link">
    <sensor name="overhead_camera" type="camera">
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <topic>/waferflow/camera/image_raw</topic>
      <camera>
        <horizontal_fov>0.8</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.01</near>
          <far>2.0</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>

  <!-- ── Gazebo material overrides ─────────────────────────────────────── -->
  <gazebo reference="base_link">
    <material>Gazebo/DarkGrey</material>
  </gazebo>
  <gazebo reference="z_carriage">
    <material>Gazebo/Grey</material>
  </gazebo>
  <gazebo reference="link_1">
    <material>Gazebo/White</material>
  </gazebo>
  <gazebo reference="link_2">
    <material>Gazebo/White</material>
  </gazebo>
  <gazebo reference="ee_base">
    <material>Gazebo/DarkGrey</material>
  </gazebo>
  <gazebo reference="ee_stem">
    <material>Gazebo/DarkGrey</material>
  </gazebo>
  <gazebo reference="ee_pad">
    <material>Gazebo/Black</material>
  </gazebo>

</robot>
