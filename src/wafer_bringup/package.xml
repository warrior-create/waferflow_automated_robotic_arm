<?xml version="1.0"?>
<package format="3">
  <name>wafer_bringup</name>
  <version>0.1.0</version>
  <description>Bringup launch files and global configs for WaferFlow</description>
  <maintainer email="you@example.com">WaferFlow Developer</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>wafer_description</exec_depend>
  <exec_depend>wafer_moveit_config</exec_depend>
  <exec_depend>wafer_vision</exec_depend>
  <exec_depend>wafer_trajectory</exec_depend>
  <exec_depend>wafer_control</exec_depend>
  <exec_depend>wafer_benchmark</exec_depend>
  <exec_depend>gazebo_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
